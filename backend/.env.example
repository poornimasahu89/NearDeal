# NearDeal backend configuration — copy to `.env` and fill in real values.
# NEVER commit the real `.env` file, and never paste real secrets here.

# Port the Express API listens on
PORT=5000

# MongoDB connection string (local development default shown)
MONGO_URI=mongodb://127.0.0.1:27017/neardeal

# Secret used to sign JWTs — replace with a long random string (32+ characters)
JWT_SECRET=replace-with-a-long-random-secret-32-chars-minimum

# Extra allowed browser origins (comma separated). localhost/127.0.0.1 are
# always allowed for local development; list production origins here.
CORS_ORIGIN=

# Brute-force budget for /api/auth/login and /api/auth/register
AUTH_RATE_WINDOW_MS=900000
AUTH_RATE_LIMIT=50
